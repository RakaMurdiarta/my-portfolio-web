---
import Icon from './Icon.astro';
import Mock from './Mock.astro';
import { projects } from '../data/site';

// Showcase: a fixed-height project list beside one stage card. The list scrolls inside
// its panel and every project shares one grid cell on the stage, so the section keeps
// the same height however many projects are added.
const filters = [
  { id: 'all', label: 'All', count: projects.length },
  { id: 'work', label: 'Work', count: projects.filter((p) => p.category === 'work').length },
  { id: 'freelance', label: 'Freelance', count: projects.filter((p) => p.category === 'freelance').length },
];

const items = projects.map((project, i) => ({
  ...project,
  id: `project-${i + 1}`,
  href: project.links[0]?.href,
  host: project.links[0] ? new URL(project.links[0].href).hostname : '',
}));
---

<section class="section projects" id="projects">
  <span class="circle projects__circle projects__circle--one" aria-hidden="true"></span>
  <span class="circle projects__circle projects__circle--two" aria-hidden="true"></span>

  <h2 class="label projects__label">... /Projects ...</h2>

  <div class="showcase" data-reveal data-showcase>
    <div class="side">
      <div class="side__inner">
        <div class="side__filters" role="group" aria-label="Filter projects">
          {
            filters.map((filter, i) => (
              <button
                class="filter"
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-filter={filter.id}
                data-label={filter.label}
              >
                {filter.label}
                <span class="filter__count">{filter.count}</span>
              </button>
            ))
          }
        </div>

        <nav class="side__scroll" aria-label="Projects" data-list>
          <ul class="side__list" role="tablist" aria-orientation="vertical">
            {
              items.map((item, i) => (
                <li role="presentation" data-category={item.category}>
                  <button
                    class="row"
                    type="button"
                    role="tab"
                    id={`${item.id}-tab`}
                    aria-controls={item.id}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    data-project={item.id}
                  >
                    <span class="row__text">
                      <span class="row__name">{item.name}</span>
                      <span class="row__client">{item.client}</span>
                    </span>
                    <span class="row__arrow" aria-hidden="true">
                      <Icon name="arrow-right" size={14} />
                    </span>
                  </button>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div class="card">
      <div class="card__bar">
        <p class="card__scope mono" aria-live="polite" data-scope>All projects</p>
        <div class="card__controls">
          <button class="card__arrow card__arrow--prev" type="button" aria-label="Previous project" data-step="-1">
            <Icon name="arrow-right" size={16} />
          </button>
          <button class="card__arrow" type="button" aria-label="Next project" data-step="1">
            <Icon name="arrow-right" size={16} />
          </button>
        </div>
      </div>

      <div class="card__stage" data-stage>
        {
          items.map((item, i) => (
            <article
              class:list={['stage', { 'is-active': i === 0 }]}
              id={item.id}
              role="tabpanel"
              aria-labelledby={`${item.id}-tab`}
            >
              <div class="canvas">
                <div class="devices">
                  <div class="browser">
                    <div class="browser__bar" aria-hidden="true">
                      <span class="browser__dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="browser__url">{item.host}</span>
                    </div>
                    <div class="browser__screen">
                      {item.shots ? (
                        <img
                          src={item.shots.desktop}
                          alt={`${item.name} website on desktop`}
                          width="1200"
                          height="750"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="browser__mock" aria-hidden="true">
                          <Mock variant="dashboard" />
                        </div>
                      )}
                    </div>
                  </div>

                  <div class="phone">
                    <div class="phone__screen">
                      {item.shots ? (
                        <img
                          src={item.shots.mobile}
                          alt={`${item.name} website on mobile`}
                          width="400"
                          height="866"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="phone__glyph" aria-hidden="true">
                          {item.glyph ?? item.name}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              <div class="info">
                <div class="info__head">
                  <p class="info__meta">
                    <span class="info__badge">{item.category === 'work' ? 'Work' : 'Freelance'}</span>
                    {item.client}
                  </p>
                  <h3 class="info__name">{item.name}</h3>
                  <p class="info__summary" set:html={item.summary} />

                  {item.href && (
                    <div class="info__cta">
                      <a class="visit" href={item.href} target="_blank" rel="noopener noreferrer">
                        <span class="visit__label">{item.access ? 'Open app' : 'Visit website'}</span>
                        <span class="visit__icon">
                          <Icon name="arrow-up-right" size={16} />
                        </span>
                      </a>
                      {item.access && <p class="info__access">{item.access}</p>}
                    </div>
                  )}
                </div>

                <div class="info__body">
                  <ul class="highlights">
                    {item.highlights.map((point) => (
                      <li>
                        <span class="highlights__icon">
                          <Icon name="check" size={12} />
                        </span>
                        <span set:html={point} />
                      </li>
                    ))}
                  </ul>
                  <ul class="tags" aria-label="Tech stack">
                    {item.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Rows, prev/next arrows, arrow keys, and swipe select a project; filters narrow the list.
  const root = document.querySelector<HTMLElement>('[data-showcase]')!;
  const list = root.querySelector<HTMLElement>('[data-list]')!;
  const scope = root.querySelector<HTMLElement>('[data-scope]')!;
  const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-project]')];
  const filterButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  let visible = tabs;
  let active = tabs[0];

  // Scroll the list itself (never the page) so the chosen row sits in the middle.
  const reveal = (tab: HTMLButtonElement) => {
    const row = tab.parentElement!;
    const horizontal = list.scrollWidth > list.clientWidth + 1;
    list.scrollTo(
      horizontal
        ? { left: row.offsetLeft - (list.clientWidth - row.offsetWidth) / 2, behavior: 'smooth' }
        : { top: row.offsetTop - (list.clientHeight - row.offsetHeight) / 2, behavior: 'smooth' },
    );
  };

  const select = (tab: HTMLButtonElement, focus = false) => {
    active = tab;
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.dataset.project!)!.classList.toggle('is-active', on);
    }
    if (focus) tab.focus({ preventScroll: true });
    reveal(tab);
  };

  const step = (by: number, focus = false) => {
    const i = visible.indexOf(active);
    select(visible[(i + by + visible.length) % visible.length], focus);
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.filter!;
      filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      for (const t of tabs) t.parentElement!.hidden = id !== 'all' && t.parentElement!.dataset.category !== id;
      visible = tabs.filter((t) => !t.parentElement!.hidden);
      scope.textContent = id === 'all' ? 'All projects' : `${button.dataset.label} projects`;
      list.scrollTo({ top: 0, left: 0 });
      select(visible.includes(active) ? active : visible[0]);
    });
  });

  const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        select(visible[e.key === 'Home' ? 0 : visible.length - 1], true);
      } else if (e.key in keys) {
        e.preventDefault();
        step(keys[e.key], true);
      }
    });
  });

  root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
    button.addEventListener('click', () => step(Number(button.dataset.step)));
  });

  // Horizontal swipe on the stage; mostly-vertical drags are left to page scrolling.
  const stage = root.querySelector<HTMLElement>('[data-stage]')!;
  let startX = 0;
  let startY = 0;
  stage.addEventListener('touchstart', (e) => ([startX, startY] = [e.touches[0].clientX, e.touches[0].clientY]), { passive: true });
  stage.addEventListener(
    'touchend',
    (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
    },
    { passive: true },
  );
</script>

<style>
  .projects__circle--one {
    width: 640px;
    height: 640px;
    top: 120px;
    right: -420px;
  }

  .projects__circle--two {
    width: 560px;
    height: 560px;
    top: 45%;
    left: -380px;
  }

  .projects__label {
    text-align: center;
  }

  .showcase {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }

  /* ---------- Side panel: filters + list (sideways chips on phones) ---------- */

  .side__inner {
    display: grid;
    gap: 12px;
  }

  .side__filters {
    display: flex;
    gap: 4px;
    width: fit-content;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font-size: 13px;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .filter:hover {
    color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .filter__count {
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.7;
  }

  .side__scroll {
    position: relative;
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    padding: 2px var(--gutter) 6px;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .side__scroll::-webkit-scrollbar {
    display: none;
  }

  .side__list {
    display: flex;
    gap: 6px;
    width: max-content;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }

  .row__text {
    display: grid;
    min-width: 0;
  }

  .row__name {
    font-size: 14px;
    line-height: 1.3;
  }

  /* Client line and arrow only have room in the desktop panel. */
  .row__client,
  .row__arrow {
    display: none;
  }

  .row[aria-selected='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  /* ---------- Card: bar, stage (canvas + info) ---------- */

  .card {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .card__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px 10px 20px;
    border-bottom: 1px solid var(--line);
  }

  .card__scope {
    font-size: 12px;
    color: var(--muted);
  }

  .card__controls {
    display: flex;
    gap: 6px;
  }

  .card__arrow {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }

  .card__arrow:hover {
    border-color: var(--accent);
    background: var(--accent);
  }

  .card__arrow--prev :global(svg) {
    transform: scaleX(-1);
  }

  /* With JS, every project shares one grid cell: the card is as tall as the tallest
     project and doesn't jump when switching. Without JS they simply stack. */
  .card__stage {
    display: grid;
  }

  :global(.js) .stage {
    grid-area: 1 / 1;
  }

  :global(.js) .stage:not(.is-active) {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .stage {
      transition:
        opacity 0.45s var(--ease),
        visibility 0s linear 0.45s;
    }

    :global(.js) .stage.is-active {
      transition:
        opacity 0.45s var(--ease),
        visibility 0s;
    }

    :global(.js) .stage .devices {
      transition: transform 0.6s var(--ease);
    }

    :global(.js) .stage:not(.is-active) .devices {
      transform: translateY(16px) scale(0.98);
    }
  }

  .stage {
    display: flex;
    flex-direction: column;
  }

  /* ---------- Canvas: browser window with a phone overlapping its corner ---------- */

  .canvas {
    padding: 28px 20px 24px;
    background:
      radial-gradient(120% 90% at 85% 100%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 60%),
      var(--soft);
  }

  .devices {
    position: relative;
    max-width: 640px;
    margin-inline: auto;
    padding-right: 13%;
    padding-bottom: 5%;
  }

  .browser {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 24px 48px -28px color-mix(in srgb, var(--ink) 50%, transparent);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--line);
  }

  .browser__dots {
    display: flex;
    gap: 4px;
  }

  .browser__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }

  .browser__url {
    flex: 1;
    overflow: hidden;
    padding: 1px 10px;
    border-radius: 999px;
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser__screen {
    aspect-ratio: 16 / 10;
    background: var(--soft);
  }

  .browser__screen img,
  .phone__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .browser__mock {
    width: 100%;
    height: 100%;
    background: var(--ink);
  }

  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 25%;
    padding: 3px;
    border-radius: 16px;
    background: var(--ink);
    box-shadow: 0 20px 40px -18px color-mix(in srgb, var(--ink) 60%, transparent);
  }

  .phone__screen {
    display: grid;
    place-items: center;
    overflow: hidden;
    aspect-ratio: 400 / 866;
    border-radius: 13px;
    background: color-mix(in srgb, var(--accent) 45%, var(--soft));
    container-type: inline-size;
  }

  .phone__glyph {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 22cqi;
    color: var(--ink);
  }

  /* ---------- Info ---------- */

  .info {
    display: grid;
    gap: 24px;
    padding: 24px 20px 28px;
  }

  .info__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .info__badge {
    padding: 1px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 35%, var(--soft));
    color: var(--ink);
  }

  .info__name {
    margin-top: 10px;
    font-size: 26px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink);
  }

  .info__summary {
    margin-top: 8px;
    font-size: 15px;
  }

  .info__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 20px;
  }

  .info__access {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .visit__label {
    display: grid;
    place-items: center;
    height: 40px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-size: 14px;
    font-style: italic;
  }

  .visit__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .visit:hover .visit__icon {
    transform: translate(3px, -3px);
  }

  .highlights {
    display: grid;
    gap: 10px;
    font-size: 14px;
    line-height: 1.55;
  }

  .highlights li {
    display: flex;
    gap: 10px;
  }

  .highlights__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }

  .tag {
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--soft);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink);
  }

  @media (min-width: 640px) {
    .canvas {
      padding: 40px 40px 32px;
    }

    .info {
      grid-template-columns: 1fr 1.2fr;
      gap: 32px;
      padding: 28px 32px 32px;
    }

    .info__name {
      font-size: 30px;
    }
  }

  /* Desktop: list on the left, card on the right. */
  @media (min-width: 1024px) {
    .showcase {
      grid-template-columns: 272px 1fr;
      gap: 24px;
      margin-top: 64px;
    }

    /* The panel stretches to the card's height; its list scrolls inside, so the
       section never grows with the number of projects and nothing sticks while scrolling. */
    .side {
      position: relative;
      align-self: stretch;
    }

    .side__inner {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-md);
      background: var(--surface);
    }

    .side__filters {
      flex: none;
      width: auto;
      margin: 10px;
      border: 0;
      background: var(--bg);
    }

    .filter {
      flex: 1;
      justify-content: center;
      padding: 6px 8px;
    }

    .side__scroll {
      flex: 1;
      overflow-x: hidden;
      overflow-y: auto;
      margin: 0;
      padding: 4px 10px 24px;
      border-top: 1px solid var(--line);
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
      /* Soft fade at the bottom hints that the list scrolls. */
      mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
    }

    .side__scroll::-webkit-scrollbar {
      display: block;
      width: 6px;
    }

    .side__scroll::-webkit-scrollbar-thumb {
      border-radius: 3px;
      background: var(--line);
    }

    .side__list {
      flex-direction: column;
      gap: 2px;
      width: auto;
      padding-top: 6px;
    }

    .row {
      gap: 12px;
      padding: 10px 12px;
      border-color: transparent;
      border-radius: var(--radius-sm);
      background: transparent;
      white-space: normal;
    }

    .row:hover:not([aria-selected='true']) {
      background: var(--soft);
    }

    .row__text {
      flex: 1;
    }

    .row__name {
      overflow: hidden;
      font-size: 15px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .row__client {
      display: block;
      overflow: hidden;
      margin-top: 1px;
      font-size: 12px;
      color: var(--muted);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .row[aria-selected='true'] .row__client {
      color: color-mix(in srgb, var(--bg) 70%, transparent);
    }

    .row__arrow {
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--accent);
      color: var(--ink);
      opacity: 0;
      transform: translateX(-4px);
      transition:
        opacity 0.25s var(--ease),
        transform 0.25s var(--ease);
    }

    .row[aria-selected='true'] .row__arrow {
      opacity: 1;
      transform: none;
    }

    .canvas {
      padding: 44px 56px 36px;
    }

    .info {
      padding: 32px 40px 36px;
    }
  }
</style>
