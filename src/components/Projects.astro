---
import IconLink from './IconLink.astro';
import Mock from './Mock.astro';
import { projects } from '../data/site';
---

<section class="section projects" id="projects">
  <span class="circle projects__circle projects__circle--one" aria-hidden="true"></span>
  <span class="circle projects__circle projects__circle--two" aria-hidden="true"></span>

  <h2 class="label projects__label">... /Projects ...</h2>

  <div class="projects__list">
    {
      projects.map((project, i) => {
        const areas = project.areas.map((row) => `"${row}"`).join(' ');
        const decorative = project.tiles.every((tile) => !tile.src);
        return (
          <article class:list={['project', { 'project--flip': i % 2 === 1 }]}>
            <div class="collage" style={`grid-template-areas: ${areas}`} aria-hidden={decorative ? 'true' : undefined} data-reveal>
              {project.tiles.map((tile) => (
                <div class={`tile tile--${tile.tone ?? 'soft'}`} style={`grid-area: ${tile.area}`}>
                  {tile.src ? (
                    <img src={tile.src} alt={tile.alt ?? ''} loading="lazy" decoding="async" />
                  ) : (
                    <Mock variant={tile.mock ?? 'scene'} glyph={tile.glyph} />
                  )}
                </div>
              ))}
            </div>

            <div class="project__info" data-reveal>
              <h3 class="project__name">{project.name}</h3>
              <ul class="tags" aria-label="Tech stack">
                {project.tags.map((tag) => <li class="tag">{tag}</li>)}
              </ul>
              <div class="project__desc">
                {project.description.map((part) => <div set:html={part} />)}
              </div>
              <div class="project__links">
                {project.links.map((link) => <IconLink link={link} />)}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .projects__circle--one {
    width: 640px;
    height: 640px;
    top: 120px;
    right: -420px;
  }

  .projects__circle--two {
    width: 560px;
    height: 560px;
    top: 45%;
    left: -380px;
  }

  .projects__label {
    text-align: center;
  }

  .projects__list {
    display: grid;
    gap: 96px;
    margin-top: 40px;
  }

  .project {
    display: grid;
    gap: 32px;
  }

  /* ---------- Collage: 6-column grid, tiles placed by named areas ---------- */

  .collage {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: clamp(44px, 12vw, 84px);
    gap: 8px;
  }

  .tile {
    overflow: hidden;
    border-radius: 16px;
    container-type: size;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile--ink {
    background: var(--ink);
    color: var(--bg);
    --sky-top: var(--ink);
    --sky-bottom: var(--muted);
    --moon: var(--accent);
    --star: var(--soft);
    --hill: var(--bg);
  }

  .tile--soft {
    background: var(--soft);
    color: var(--ink);
  }

  .tile--surface {
    background: var(--surface);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tile--mint {
    background: color-mix(in srgb, var(--accent) 45%, var(--soft));
    color: var(--ink);
    --sky-top: var(--soft);
    --sky-bottom: color-mix(in srgb, var(--accent) 60%, var(--soft));
  }

  /* ---------- Info ---------- */

  .project__name {
    font-size: 17px;
    font-weight: 400;
    color: var(--ink);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .tag {
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--soft);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
  }

  .project__desc {
    display: grid;
    gap: 14px;
    margin-top: 24px;
    font-size: 14px;
  }

  .project__desc :global(ul) {
    margin-top: 6px;
    padding-left: 18px;
    list-style: disc;
  }

  .project__desc :global(li) {
    margin-top: 4px;
  }

  .project__desc :global(li::marker) {
    color: var(--accent);
  }

  .project__links {
    display: flex;
    gap: 12px;
    margin-top: 28px;
  }

  @media (min-width: 640px) {
    .tile {
      border-radius: var(--radius-md);
    }

    .collage {
      gap: 12px;
    }

    .project__name {
      font-size: 20px;
    }
  }

  /* Desktop: info beside collage, alternating sides. */
  @media (min-width: 1024px) {
    .projects__list {
      gap: 160px;
      margin-top: 64px;
    }

    .project {
      grid-template-columns: 1fr 1.6fr;
      gap: 64px;
      align-items: center;
    }

    .project__info {
      grid-row: 1;
      grid-column: 1;
    }

    .collage {
      grid-column: 2;
      grid-auto-rows: 72px;
    }

    .project--flip {
      grid-template-columns: 1.6fr 1fr;
    }

    .project--flip .collage {
      grid-column: 1;
    }

    .project--flip .project__info {
      grid-column: 2;
    }

    .project__desc {
      font-size: 15px;
    }
  }
</style>
