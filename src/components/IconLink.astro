---
import Icon from './Icon.astro';
import type { SocialLink } from '../data/site';

interface Props {
  link: SocialLink;
}

// Outline brand circle + overlapping mint arrow circle, as in the reference.
const { link } = Astro.props;
---

<a class="icon-link" href={link.href} target="_blank" rel="noopener noreferrer">
  <span class="icon-link__brand"><Icon name={link.icon} size={16} /></span>
  <span class="icon-link__arrow"><Icon name="arrow-up-right" size={18} /></span>
  <span class="visually-hidden">View on {link.label} ↗</span>
</a>

<style>
  .icon-link {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }

  .icon-link__brand,
  .icon-link__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }

  .icon-link__brand {
    border: 1px solid var(--line);
    background: var(--bg);
    padding-right: 10px;
  }

  .icon-link__arrow {
    margin-left: -16px;
    background: var(--accent);
    transition: transform 0.3s var(--ease);
  }

  .icon-link:hover .icon-link__arrow {
    transform: translate(3px, -3px);
  }
</style>
