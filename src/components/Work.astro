---
import { work } from '../data/site';
import { experience, formatRange, periodDuration } from '../lib/experience';

const rows = work.map((job) => ({
  ...job,
  range: formatRange(job),
  duration: periodDuration(job),
}));
const total = experience(work).total;
---

<section class="work" id="work">
  <h2 class="display work__title" data-reveal>Work</h2>

  <ol class="work__list" data-reveal>
    {
      rows.map((job) => (
        <li class="work__row">
          <p class="work__period">
            {job.range}
            {job.duration && <small>{job.duration}</small>}
          </p>
          <p class="work__company">{job.company}</p>
          <p class="work__role mono">
            {job.role}
            {job.focus && (
              <>
                <span class="work__sep" aria-hidden="true" />
                <span class="visually-hidden">—</span>
                <span class="work__focus">{job.focus}</span>
              </>
            )}
          </p>
        </li>
      ))
    }
  </ol>

  <p class="work__total">
    Work experience<br />
    <em>{total}</em>
  </p>
</section>

<style>
  .work {
    margin-top: var(--section-gap);
  }

  .work__title {
    padding-inline: var(--gutter);
    text-align: right;
    margin-bottom: 24px;
  }

  /* Rows run edge to edge of the frame, like the reference table. */
  .work__list {
    border-top: 1px solid var(--line);
  }

  .work__row {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    grid-template-areas:
      'period company'
      'period role';
    gap: 4px 16px;
    padding: 18px var(--gutter);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .work__period {
    grid-area: period;
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
  }

  .work__period small {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--muted);
  }

  .work__company {
    grid-area: company;
    color: var(--ink);
    font-size: 13px;
  }

  .work__role {
    grid-area: role;
    color: var(--ink);
    line-height: 1.6;
  }

  /* Mobile: stack sits on its own line under the role; inline with a divider from 640px. */
  .work__sep {
    display: none;
    width: 1px;
    height: 1.1em;
    margin: 0 0.6em;
    vertical-align: -0.2em;
    background: currentColor;
  }

  .work__focus {
    display: block;
    color: var(--muted);
  }

  /* F-04: hovered row fills with ink, mint dot on the left. */
  .work__row::before {
    content: '';
    position: absolute;
    left: calc(var(--gutter) / 2 - 3px);
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: translateY(-50%) scale(0);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .work__row:hover {
    background: var(--ink);
  }

  .work__row:hover::before {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .work__row:hover p,
  .work__row:hover small,
  .work__row:hover .work__focus {
    color: var(--bg);
  }

  .work__total {
    margin-top: 24px;
    padding-inline: var(--gutter);
    text-align: right;
    font-size: 14px;
  }

  @media (min-width: 640px) {
    .work__row {
      grid-template-columns: 9rem 12rem 1fr;
      grid-template-areas: 'period company role';
      align-items: center;
      padding-block: 20px;
    }

    .work__period,
    .work__company {
      font-size: 15px;
    }

    .work__sep {
      display: inline-block;
    }

    .work__focus {
      display: inline;
      color: inherit;
    }
  }

  @media (min-width: 1024px) {
    .work__row {
      grid-template-columns: 10rem 1fr 1.6fr;
    }

    .work__period,
    .work__company {
      font-size: 17px;
    }

    .work__period small {
      font-size: 12px;
    }

    .work__total {
      font-size: 16px;
      margin-top: 32px;
    }
  }
</style>
