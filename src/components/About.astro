---
import IconLink from './IconLink.astro';
import { about, site, skills, socials, work } from '../data/site';
import { experience } from '../lib/experience';

const intro = about.intro.replace('{years}', experience(work).short);
const [primary, second, third, fourth] = skills;
---

<section class="section about" id="about">
  <span class="circle about__circle" aria-hidden="true"></span>

  <div class="about__head" data-reveal>
    <h2 class="label">... /About me ...</h2>
    <div class="about__intro">
      <p class="about__lead" set:html={intro} />
      <p set:html={about.body} />
    </div>
  </div>

  <div class="about__body">
    <figure class="about__photo" data-reveal>
      <img
        src={site.photo[800]}
        srcset={Object.entries(site.photo).map(([w, src]) => `${src} ${w}w`).join(', ')}
        sizes="(min-width: 1024px) 400px, calc(100vw - 64px)"
        alt={site.photoAlt}
        width="800"
        height="1000"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="skills" data-reveal>
      <article class="skill skill--active skill--wide">
        <h3>{primary.title}</h3>
        <p class="mono">{primary.items.join(' / ')}</p>
      </article>

      <article class="skill">
        <h3>{second.title}</h3>
        <p class="mono">{second.items.join(' / ')}</p>
      </article>
      <div class="skills__link">
        <IconLink link={socials.github} />
      </div>

      <article class="skill skill--wide">
        <h3>{third.title}</h3>
        <p class="mono">{third.items.join(' / ')}</p>
      </article>

      <p class="skills__caption" set:html={about.caption} />
      <article class="skill">
        <h3>{fourth.title}</h3>
        <p class="mono">{fourth.items.join(' / ')}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .about__circle {
    width: 560px;
    height: 560px;
    top: -120px;
    left: -420px;
  }

  .about__intro {
    display: grid;
    gap: 16px;
    margin-top: 20px;
  }

  .about__lead {
    font-size: 17px;
    line-height: 1.5;
  }

  .about__body {
    display: grid;
    gap: 40px;
    margin-top: 40px;
  }

  .about__photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 5;
    background: var(--soft);
  }

  .about__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  /* 8% ink wash so the grayscale photo sits in the mint palette. */
  .about__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink);
    opacity: 0.08;
    box-shadow: inset 0 0 0 1px var(--ink);
  }

  .skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    align-items: center;
  }

  .skill {
    height: 100%;
    padding: 18px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .skill:not(.skill--active):hover {
    background: var(--soft);
    border-color: var(--soft);
  }

  .skill--wide {
    grid-column: 1 / -1;
  }

  .skill h3 {
    font-size: 15px;
    font-weight: 400;
    color: var(--ink);
  }

  .skill p {
    margin-top: 8px;
    line-height: 2;
    word-spacing: -0.15em;
  }

  .skill--active {
    background: var(--ink);
    border-color: var(--ink);
  }

  .skill--active h3,
  .skill--active p {
    color: var(--bg);
  }

  .skills__link {
    display: grid;
    place-items: center;
  }

  .skills__caption {
    align-self: end;
    padding-bottom: 8px;
    font-size: 12px;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .about__head {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 32px;
    }

    .about__intro {
      margin-top: 0;
    }

    .about__lead {
      font-size: 19px;
    }

    .skill {
      padding: 20px 24px;
    }

    .skill h3 {
      font-size: 17px;
    }
  }

  /* Desktop: skills on the left, photo on the right. */
  @media (min-width: 1024px) {
    .about__circle {
      width: 760px;
      height: 760px;
      top: 60px;
      left: auto;
      right: -360px;
    }

    .about__head {
      grid-template-columns: 1fr 1fr;
    }

    .about__intro {
      max-width: 42ch;
    }

    .about__body {
      grid-template-columns: 1.35fr 1fr;
      gap: 80px;
      align-items: start;
      margin-top: 80px;
    }

    .about__photo {
      order: 2;
      max-width: 400px;
      justify-self: end;
      width: 100%;
    }

    .skills {
      gap: 16px;
    }

    .skills__caption {
      font-size: 13px;
    }
  }
</style>
